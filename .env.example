# Docker Compose host port. EFFICIENT_DAEMON_PORT is the container listen port.
EFFICIENT_DAEMON_PUBLISHED_PORT=8080
EFFICIENT_DAEMON_HOST=0.0.0.0
EFFICIENT_DAEMON_PORT=8080

# Optional request defaults; set these explicitly or provide them per request.
# openai (default) or jevjam.
EFFICIENT_DAEMON_PROVIDER=
EFFICIENT_DAEMON_BASE_URL=
EFFICIENT_DAEMON_MODEL=
# Leave the API key empty for providers that do not require authentication.
EFFICIENT_DAEMON_API_KEY=
EFFICIENT_DAEMON_REASONING_EFFORT=high

# Optional request defaults; leave blank to use server behavior defaults.
EFFICIENT_DAEMON_TEMPERATURE=
EFFICIENT_DAEMON_MAX_TOKENS=
EFFICIENT_DAEMON_TIMEOUT=5m
# jevjam only: most values an integer property may span (2 to 64).
EFFICIENT_DAEMON_MAX_SCORE_LEVELS=
EFFICIENT_DAEMON_WORKBENCH=true
